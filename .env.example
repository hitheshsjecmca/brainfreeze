# Copy to .env.local and fill in from Supabase → Project Settings → API.
# Leave both empty to run in LOCAL DEMO MODE (browser storage only, no auth).
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# The anon / publishable key ONLY. It is public by design and protected by RLS.
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_OR_PUBLISHABLE_KEY
# NEVER put the service-role / secret key in any VITE_ variable: Vite embeds
# every VITE_ variable into the public JavaScript bundle. This app does not
# need the service-role key at all.
